[
 {
  "version": "aksiyon",
  "n": 1,
  "file": "tomris-audio/versions/aksiyon/vo_aks_01.mp3",
  "text": "Önce bir çizgiydi.",
  "voice": "Alp",
  "voice_id": "HV5rAif1q1ITHdvxqyMw",
  "model": "eleven_v4",
  "chars": 18,
  "flow": null,
  "duration_s": 1.38,
  "at": null
 },
 {
  "version": "aksiyon",
  "n": 2,
  "file": "tomris-audio/versions/aksiyon/vo_aks_02.mp3",
  "text": "Gemide tek bir asker yok.",
  "voice": "Alp",
  "voice_id": "HV5rAif1q1ITHdvxqyMw",
  "model": "eleven_v4",
  "chars": 25,
  "flow": null,
  "duration_s": 1.65,
  "at": null
 },
 {
  "version": "aksiyon",
  "n": 3,
  "file": "tomris-audio/versions/aksiyon/vo_aks_03.mp3",
  "text": "On üç metre. On ton. Otuz beş knot.",
  "voice": "Alp",
  "voice_id": "HV5rAif1q1ITHdvxqyMw",
  "model": "eleven_v4",
  "chars": 35,
  "flow": null,
  "duration_s": 3.06,
  "at": null
 },
 {
  "version": "aksiyon",
  "n": 4,
  "file": "tomris-audio/versions/aksiyon/vo_aks_04.mp3",
  "text": "Uzaktan ya da tamamen otonom.",
  "voice": "Alp",
  "voice_id": "HV5rAif1q1ITHdvxqyMw",
  "model": "eleven_v4",
  "chars": 29,
  "flow": null,
  "duration_s": 2.22,
  "at": null
 },
 {
  "version": "aksiyon",
  "n": 5,
  "file": "tomris-audio/versions/aksiyon/vo_aks_05.mp3",
  "text": "Yirmi insansız araç incelendi. Her ölçü doğrulandı.",
  "voice": "Alp",
  "voice_id": "HV5rAif1q1ITHdvxqyMw",
  "model": "eleven_v4",
  "chars": 51,
  "flow": null,
  "duration_s": 3.55,
  "at": null
 },
 {
  "version": "aksiyon",
  "n": 6,
  "file": "tomris-audio/versions/aksiyon/vo_aks_06.mp3",
  "text": "Gün biter. Nöbet başlar.",
  "voice": "Alp",
  "voice_id": "HV5rAif1q1ITHdvxqyMw",
  "model": "eleven_v4",
  "chars": 24,
  "flow": null,
  "duration_s": 2.3,
  "at": null
 },
 {
  "version": "aksiyon",
  "n": 7,
  "file": "tomris-audio/versions/aksiyon/vo_aks_07.mp3",
  "text": "İstanbul Teknik Üniversitesi'nde tasarlandı.",
  "voice": "Alp",
  "voice_id": "HV5rAif1q1ITHdvxqyMw",
  "model": "eleven_v4",
  "chars": 44,
  "flow": null,
  "duration_s": 2.43,
  "at": null
 },
 {
  "version": "aksiyon",
  "n": 8,
  "file": "tomris-audio/versions/aksiyon/vo_aks_08.mp3",
  "text": "TOMRİS.",
  "voice": "Alp",
  "voice_id": "HV5rAif1q1ITHdvxqyMw",
  "model": "eleven_v4",
  "chars": 7,
  "flow": null,
  "duration_s": 0.65,
  "at": null
 },
 {
  "version": "milli",
  "n": 1,
  "file": "tomris-audio/versions/milli/vo_mil_01.mp3",
  "text": "Her şey, bir çizgiyle başladı.",
  "voice": "GİZEM",
  "voice_id": "YHK57o4iMmVGSTo059Sj",
  "model": "eleven_v4",
  "chars": 30,
  "flow": null,
  "duration_s": 2.32,
  "at": null
 },
 {
  "version": "milli",
  "n": 2,
  "file": "tomris-audio/versions/milli/vo_mil_02.mp3",
  "text": "İstanbul Teknik Üniversitesi'nden beş Türk genci. Tek bir hayal.",
  "voice": "GİZEM",
  "voice_id": "YHK57o4iMmVGSTo059Sj",
  "model": "eleven_v4",
  "chars": 64,
  "flow": null,
  "duration_s": 4.34,
  "at": null
 },
 {
  "version": "milli",
  "n": 3,
  "file": "tomris-audio/versions/milli/vo_mil_03.mp3",
  "text": "On üç metre, on ton. Gemide tek bir asker yok.",
  "voice": "GİZEM",
  "voice_id": "YHK57o4iMmVGSTo059Sj",
  "model": "eleven_v4",
  "chars": 46,
  "flow": null,
  "duration_s": 4.0,
  "at": null
 },
 {
  "version": "milli",
  "n": 4,
  "file": "tomris-audio/versions/milli/vo_mil_04.mp3",
  "text": "Yirmi insansız deniz aracı incelendi; her ölçü, hesapla doğrulandı.",
  "voice": "GİZEM",
  "voice_id": "YHK57o4iMmVGSTo059Sj",
  "model": "eleven_v4",
  "chars": 67,
  "flow": null,
  "duration_s": 5.09,
  "at": null
 },
 {
  "version": "milli",
  "n": 5,
  "file": "tomris-audio/versions/milli/vo_mil_05.mp3",
  "text": "Cumhuriyet'in gençlerinden, Mavi Vatan'a.",
  "voice": "GİZEM",
  "voice_id": "YHK57o4iMmVGSTo059Sj",
  "model": "eleven_v4",
  "chars": 41,
  "flow": null,
  "duration_s": 2.72,
  "at": null
 },
 {
  "version": "milli",
  "n": 6,
  "file": "tomris-audio/versions/milli/vo_mil_06.mp3",
  "text": "Ey Türk gençliği! Birinci vazifen, Türk istiklâlini, Türk Cumhuriyetini, ilelebet muhafaza ve müdafaa etmektir.",
  "voice": "GİZEM",
  "voice_id": "YHK57o4iMmVGSTo059Sj",
  "model": "eleven_v4",
  "chars": 111,
  "flow": null,
  "duration_s": 8.7,
  "at": null
 },
 {
  "version": "osmanli",
  "n": 1,
  "file": "tomris-audio/versions/osmanli/vo_osm_01.mp3",
  "text": "Her gemi, önce bir çizgidir.",
  "voice": "Seyfullah Kartal",
  "voice_id": "mF7tIc9VLrznhGooGjaT",
  "model": "eleven_v4",
  "chars": 28,
  "flow": null,
  "duration_s": 2.61,
  "at": null
 },
 {
  "version": "osmanli",
  "n": 2,
  "file": "tomris-audio/versions/osmanli/vo_osm_02.mp3",
  "text": "Barbaros'un yelken açtığı denizlerde, yeni bir nöbetçi.",
  "voice": "Seyfullah Kartal",
  "voice_id": "mF7tIc9VLrznhGooGjaT",
  "model": "eleven_v4",
  "chars": 55,
  "flow": null,
