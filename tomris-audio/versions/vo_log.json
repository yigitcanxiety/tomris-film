  "at": null
 },
 {
  "version": "osmanli",
  "n": 3,
  "file": "tomris-audio/versions/osmanli/vo_osm_03.mp3",
  "text": "On üç metre. On ton. İki su jeti.",
  "voice": "Seyfullah Kartal",
  "voice_id": "mF7tIc9VLrznhGooGjaT",
  "model": "eleven_v4",
  "chars": 33,
  "flow": null,
  "duration_s": 3.5,
  "at": null
 },
 {
  "version": "osmanli",
  "n": 4,
  "file": "tomris-audio/versions/osmanli/vo_osm_04.mp3",
  "text": "Ne kürek, ne yelken, ne tayfa.",
  "voice": "Seyfullah Kartal",
  "voice_id": "mF7tIc9VLrznhGooGjaT",
  "model": "eleven_v4",
  "chars": 30,
  "flow": null,
  "duration_s": 3.06,
  "at": null
 },
 {
